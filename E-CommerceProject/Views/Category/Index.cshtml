@{
    ViewData["Title"] = "Categories";
    Layout = "_AdminLayout";
}

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" rel="stylesheet" />

<style>
    .dt-img {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 6px;
        display: block;
        margin: 0 auto;
    }

    .dt-desc {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #ProductsTbl td {
        vertical-align: middle;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}

<div class ="mt-5" style="background-color:beige">

    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-bold ms-2" style="font-size:x-large; color:brown;">@ViewData["Title"]</h6>
        <a asp-action="Create" class="btn btn-primary btn-sm me-2">
            <i class="fal fa-plus me-1"></i> Add Category
        </a>
    </div>

    <div class="card-body mt-4">
        <div style="overflow-x: auto;">
            <table id="CategoriesTbl" class="table dt table-hover table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Created At</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script>
        const urls = {
        list:    '@Url.Action("GetCategoriesList", "Category")',
        details: '@Url.Action("Details", "Category")',
        edit:    '@Url.Action("Edit", "Category")',
        delete:  '@Url.Action("Delete", "Category")'
        };

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();

        function esc(value) {
        return $('<div>').text(value ?? '').html();
        }

        $(function () {
            const table = $('#CategoriesTbl').DataTable({
                processing: true,
                serverSide: true,
                destroy:    true,
                responsive: false,
                scrollX:    true,
                stateSave:  true,
                order:      [[0, 'desc']],
                lengthMenu: [[10, 25, 50, 100, 500], [10, 25, 50, 100, 500]],
                language: {
                emptyTable:  'No categories found.',
                zeroRecords: 'No matching categories found.',
                processing:  '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Loading…'
                },
                ajax: {
                    url:   urls.list,
                    type:  'GET',
                    error: function () {
                        alert('Could not load categories. Please refresh the page.');
                    }
                },
                columns: [
                { data: 'CategoryId', width: '60px' },
                { data: 'Name', width: '150px' },
                {
                    data:  'CreatedAt',
                    width: '110px',
                    render: function (data, type) {
                        if (!data) return '—';
                        const d = new Date(data);
                        if (isNaN(d)) return data;
                        return type === 'display' || type === 'filter' ? d.toLocaleDateString() : d.getTime();
                    }
                },
                {
                    data:       null,
                    orderable:  false,
                    searchable: false,
                    width:      '110px',
                    className:  'text-center',
                    render: function (data, type, row) {
                        const id   = esc(String(row.CategoryId));
                        const name = esc(row.Name ?? '');
                        return `
                            <a href="${urls.edit}?CategoryId=${id}" class="btn btn-warning" title="Edit">
                            <i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-danger js-dt-delete" data-id="${id}" data-name="${name}" title="Delete">
                            <i class="bi bi-trash"></i></button>
                            </div>`;
                    }
                }
                ],

                dom:'<"d-flex justify-content-between align-items-center mb-3"B<"ms-auto"f>>rt<"d-flex justify-content-between align-items-center mt-3"lip>',
                buttons: [
                    {
                        extend:    'excelHtml5',
                        text:      '<i class="bi bi-file-earmark-spreadsheet me-2"></i>Export to Excel',
                        title:     '@ViewData["Title"]',
                        className: 'btn btn-outline-success px-3 py-2 shadow-sm',
                        exportOptions: { modifier: { page: 'current' } }
                    },
                    {
                        text: '<i class="bi bi-arrow-clockwise me-2"></i>Reset Table',
                        className: 'btn btn-outline-secondary px-3 py-2 shadow-sm',
                        action: function (e, dt) {
                            dt.state.clear();
                            window.location.reload();
                        }
                    }
                ],

                initComplete: function () {
                    $('#CategoriesTbl tbody').on('click', '.js-dt-delete', function () {
                        const $btn = $(this);
                        const id   = $btn.data('id');
                        const name = $btn.data('name');

                        if (!confirm(`Delete "${name}"?\nThis action cannot be undone.`)) return;

                        $btn.prop('disabled', true);

                        $.ajax({
                            url:  `${urls.delete}?CategoryId=${id}`,
                            type: 'POST',
                            data: { __RequestVerificationToken: csrfToken },
                            success: function () {
                                table.ajax.reload(null, false);
                            },
                            error: function (xhr) {
                                const msg = xhr.responseJSON?.message
                                ?? 'Failed to delete category. Please try again.';
                                alert(msg);
                                $btn.prop('disabled', false);
                            }
                        });
                    });
                }
            });
        });
    </script>
}
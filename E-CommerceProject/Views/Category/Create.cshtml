@model CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Categories</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Add New Category</h1>
        </div>
        <div class="mt-2 mt-md-0">
            <a asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Categories
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="needs-validation">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <span>Please fix the errors below before proceeding.</span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control" id="categoryName" placeholder="Category Name" autocomplete="off" autofocus />
                            <label asp-for="Name">Category Name</label>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-light text-secondary px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Add
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
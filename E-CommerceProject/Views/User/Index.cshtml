@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<!-- DataTables & Custom Styles -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" rel="stylesheet" />

<style>
    .table > :not(caption) > * > * {
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }

    .dataTables_wrapper .dataTables_filter input {
        border-radius: 0.5rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid #dee2e6;
    }

    .dataTables_wrapper .dataTables_length select {
        border-radius: 0.5rem;
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        border: 1px solid #dee2e6;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .btn-hover-lift {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .btn-hover-lift:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}

<div class="container-fluid px-4 py-4">

    <!-- Hero / Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Users</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-1">User Directory</h1>
            <p class="text-muted small mb-0">Discover system users.</p>
        </div>
    </div>

    <!-- Main Data Table Container -->
    <div class="border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4" style="background-color:beige">
            <div class="table-responsive">
                <table id="UsersTbl" class="table table-hover align-middle w-100 border-top-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="fw-semibold text-secondary" style="width: 50px;">User</th>
                            <th class="fw-semibold text-secondary">Username</th>
                            <th class="fw-semibold text-secondary">Email</th>
                            <th class="fw-semibold text-secondary">Roles</th>
                            <th class="fw-semibold text-secondary text-center" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script>
        const urls = {
            list: '@Url.Action("GetUsersList", "User")',
            details: '@Url.Action("Details", "User")',
            edit: '@Url.Action("Edit", "User")',
            manageRoles: '@Url.Action("ManageRole", "User")',
            deleteUser: '@Url.Action("Delete", "User")',
        };

        function esc(value) {
            return $('<div>').text(value ?? '').html();
        }

        $(function() {
            const table = $('#UsersTbl').DataTable({
                processing: true,
                serverSide: true,
                destroy: true,
                responsive: false,
                scrollX: true,
                stateSave: true,
                order: [[1, 'asc']],
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                language: {
                    emptyTable: 'No users registered in the system.',
                    zeroRecords: 'No matching users found.',
                    processing: '<span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>Loading users...',
                    search: "_INPUT_",
                    searchPlaceholder: "Search users..."
                },
                ajax: {
                    url: urls.list,
                    type: 'GET',
                    error: function() {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Could not load user data. Please refresh.');
                        }
                    }
                },
                columns: [
                    // Initial Avatar Thumbnail
                    {
                        data: 'Username',
                        orderable: false,
                        searchable: false,
                        width: '50px',
                        render: function(data) {
                            const name = esc(data ?? 'U');
                            const initial = name.charAt(0).toUpperCase();
                            return `<div class="user-avatar shadow-sm">${initial}</div>`;
                        }
                    },

                    // Username & Full Name Subtext
                    {
                        data: 'Username',
                        width: '180px',
                        render: function(data, type, row) {
                            const username = esc(data ?? 'N/A');
                            const id = esc(String(row.Id ?? row.UserId));
                            const fullName = esc(row.FullName ?? `${row.FirstName ?? ''} ${row.LastName ?? ''}`.trim());

                            return `
                                        <div>
                                            <a href="${urls.edit}?id=${id}" class="fw-semibold text-dark text-decoration-none">
                                                ${username}
                                            </a>
                                            ${fullName ? `<small class="d-block text-muted" style="font-size: 0.78rem;">${fullName}</small>` : ''}
                                        </div>`;
                        }
                    },

                    // Email Address
                    {
                        data: 'Email',
                        width: '220px',
                        render: function(data) {
                            if (!data) return '<span class="text-muted">—</span>';
                            const safeEmail = esc(data);
                            return `<a href="mailto:${safeEmail}" class="text-secondary text-decoration-none">${safeEmail}</a>`;
                        }
                    },

                    // Roles Badges
                    {
                        data: 'Roles',
                        width: '200px',
                        render: function(data) {
                            // Handles both Array of strings ["Admin", "User"] or comma-separated string "Admin, User"
                            let rolesArray = [];
                            if (Array.isArray(data)) {
                                rolesArray = data;
                            } else if (typeof data === 'string' && data.trim() !== '') {
                                rolesArray = data.split(',');
                            }

                            if (rolesArray.length === 0) {
                                return '<span class="badge bg-light text-muted border">No Roles</span>';
                            }

                            return rolesArray.map(role => {
                                const cleanRole = esc(role.trim());
                                let badgeClass = 'bg-secondary-subtle text-secondary border-secondary-subtle';

                                // Optional: Special colors for primary roles
                                if (cleanRole.toLowerCase() === 'admin' || cleanRole.toLowerCase() === 'administrator') {
                                    badgeClass = 'bg-danger-subtle text-danger border-danger-subtle';
                                } else if (cleanRole.toLowerCase() === 'manager') {
                                    badgeClass = 'bg-primary-subtle text-primary border-primary-subtle';
                                } else if (cleanRole.toLowerCase() === 'user' || cleanRole.toLowerCase() === 'customer') {
                                    badgeClass = 'bg-info-subtle text-info border-info-subtle';
                                }

                                return `<span class="badge ${badgeClass} border me-1">${cleanRole}</span>`;
                            }).join('');
                        }
                    },

                    // User Management Actions
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        width: '140px',
                        className: 'text-center',
                        render: function(data, type, row) {
                            const id = esc(String(row.Id ?? row.UserId));
                            return `
                                        <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                                            <a href="${urls.details}?userId=${id}" class="btn btn-outline-primary" title="View Details">
                                                <span class="bi bi-eye" aria-hidden="true"></span>
                                            </a>
                                            <a href="${urls.manageRoles}?userId=${id}" class="btn btn-outline-primary" title="Manage Roles">
                                                <span class="bi bi-shield-lock" aria-hidden="true"></span>
                                            </a>
                                            <a href="${urls.edit}?id=${id}" class="btn btn-outline-secondary" title="Edit User">
                                                <span class="bi bi-pencil" aria-hidden="true"></span>
                                            </a>
                                            <a href="${urls.deleteUser}?id=${id}" class="btn btn-outline-danger" title="Delete User">
                                                <span class="bi bi-trash" aria-hidden="true"></span>
                                            </a>
                                        </div>`;
                        }
                    }
                ],

                dom: '<"d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3"B<"ms-auto"f>>rt<"d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mt-3"lip>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<span class="bi bi-file-earmark-spreadsheet me-2" aria-hidden="true"></span>Export Users',
                        title: '@ViewData["Title"]',
                        className: 'btn btn-success btn-sm rounded-3 shadow-sm px-3',
                        exportOptions: { modifier: { page: 'current' } }
                    },
                    {
                        text: '<span class="bi bi-arrow-clockwise me-2" aria-hidden="true"></span>Reset Table',
                        className: 'btn btn-outline btn-sm rounded-3 shadow-sm px-2 ms-2',
                        action: function(e, dt) {
                            dt.state.clear();
                            window.location.reload();
                        }
                    }
                ]
            });
        });
    </script>
}
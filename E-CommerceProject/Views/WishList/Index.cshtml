@model IEnumerable<WishListViewModel>
@{
    ViewData["Title"] = "My Wishlist";
    Layout = "_CustomLayout";

    var fallbackImg = "https://cdn4.iconfinder.com/data/icons/picture-sharing-sites/32/No_Image-1024.png";
    var itemCount = Model.Count();
}

<style>
    /* Wishlist Card Styling & Hover Effects */
    .wishlist-card {
        background: #ffffff;
        border: 1px solid #edf2f7;
        border-radius: 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .wishlist-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .wishlist-card__img-wrapper {
        position: relative;
        width: 100%;
        padding-top: 75%; /* 4:3 Aspect Ratio */
        overflow: hidden;
        border-top-left-radius: 1.25rem;
        border-top-right-radius: 1.25rem;
        background-color: #f8f9fa;
    }

    .wishlist-card__img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .wishlist-card:hover .wishlist-card__img {
        transform: scale(1.04);
    }

    .wishlist-card__badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 2;
        font-size: 0.75rem;
    }

    .wishlist-card__remove-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 2;
        background: #ffc107;
        backdrop-filter: blur(4px);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        border: none;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .wishlist-card__remove-btn:hover {
        background: #dc3545;
        color: #ffffff;
        transform: scale(1.1);
    }

    /* Empty State Container */
    .empty-wishlist-card {
        background: #ffffff;
        border: 1px dashed #dee2e6;
        border-radius: 1.5rem;
    }
</style>

<div class="container py-4">

    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">My Wishlist</h1>
            <p class="text-muted small mb-0">
                You have <strong>@itemCount</strong> @(itemCount == 1 ? "saved item" : "saved items")
            </p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Continue Shopping
            </a>
            <a asp-controller="Wishlist" asp-action="RemoveAllWishList" class="btn btn-danger btn-sm rounded-pill px-3">
                <i class="bi bi-trash me-1"></i> Clear Wishlist
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State View -->
        <div class="empty-wishlist-card p-5 text-center my-4">
            <div class="mb-3">
                <i class="bi bi-heart text-muted" style="font-size: 4rem;"></i>
            </div>
            <h2 class="h4 fw-bold text-dark mb-2">Your wishlist is empty</h2>
            <p class="text-muted mb-4">Explore items and save your favorites here for later!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                Discover Products
            </a>
        </div>
    }
    else
    {
        <!-- Responsive 4-Column Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                var product = item.ProductName;
                var hasDiscount =  item.ProductDiscount > 0;
                var discountPct = hasDiscount ? item.ProductDiscount : 0M;
                var finalPrice = hasDiscount ? (item.ProductPrice - (item.ProductPrice * (discountPct / 100M))) : item.ProductPrice;
                var coverUrl = string.IsNullOrWhiteSpace(item.ProductCover) ? fallbackImg : item.ProductCover;

                <div class="col">
                    <div class="card wishlist-card h-100 border-0 shadow-sm d-flex flex-column">
                        
                        <!-- Image Container & Remove Button Overlay -->
                        <div class="wishlist-card__img-wrapper">
                            <a asp-controller="Product" asp-action="Details" asp-route-productId="@item.ProductId">
                                <img src="@coverUrl" 
                                     alt="@item.ProductName" 
                                     class="wishlist-card__img" 
                                     onerror="this.src='@fallbackImg'" />
                            </a>

                            @if (hasDiscount)
                            {
                                <span class="badge bg-danger rounded-pill wishlist-card__badge">
                                    -@(discountPct.ToString("0"))% OFF
                                </span>
                            }

                            <!-- Remove from Wishlist Icon -->
                            <a asp-action="RemoveFromWishList" 
                               asp-route-productId="@item.ProductId"
                               class="wishlist-card__remove-btn shadow-sm" 
                               title="Remove from Wishlist">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>

                        <!-- Details Section -->
                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            
                            <!-- Product Title -->
                            <h2 class="h6 fw-bold mb-2">
                                <a asp-controller="Product" 
                                   asp-action="Details" 
                                   asp-route-productId="@item.ProductId"
                                   class="text-dark text-decoration-none text-truncate d-block" 
                                   title="@item.ProductName">
                                    @item.ProductName
                                </a>
                            </h2>

                            <!-- Pricing Breakdown -->
                            <div class="mb-3">
                                @if (hasDiscount)
                                {
                                    <div class="d-flex align-items-baseline gap-2">
                                        <small class="text-decoration-line-through d-block">$@item.ProductPrice.ToString("F2")</small>
                                        <span class="fs-5 fw-bold text-success">$@finalPrice.ToString("F2")</span>
                                        <small class="text-muted text-decoration-line-through">$@item.ProductPrice.ToString("F2")</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="fs-5 fw-bold text-dark">$@item.ProductPrice.ToString("F2")</span>
                                }
                            </div>

                            <!-- Action: Quick Move to Cart -->
                            <div class="mt-auto pt-2 border-top">
                                <a asp-controller="Cart" 
                                   asp-action="AddToCart" 
                                   asp-route-productId="@item.ProductId"
                                   class="btn btn-primary rounded-pill w-100 py-2 btn-sm fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                                    <i class="bi bi-cart-plus fs-6"></i> Add to Cart
                                </a>
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
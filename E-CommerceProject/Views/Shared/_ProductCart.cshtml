@model IEnumerable<Product>

@foreach (var item in Model)
{
    var name = string.IsNullOrWhiteSpace(item.Name) ? "Product" : item.Name;
    var description = string.IsNullOrWhiteSpace(item.Description) ? "No description available." : item.Description;
    var hasDiscount = item.Discount?.Percentage > 0;
    var discountedPrice = hasDiscount
        ? item.Price - (item.Price * (item.Discount!.Percentage / 100m))
        : item.Price;
    var imageUrl = string.IsNullOrWhiteSpace(item.Cover)
        ? "https://cdn4.iconfinder.com/data/icons/picture-sharing-sites/32/No_Image-1024.png"
        : item.Cover;

    <div class="col-md-4 mb-4 d-flex">
        <div class="card product-card h-100 w-100">
            <a asp-controller="Product" asp-action="Details" asp-route-productId="@item.Id" class="product-card__image-link">
                <div class="product-card__image-wrap">
                    <img class="product-card__image" src="@imageUrl" alt="@name" />
                    @if (hasDiscount)
                    {
                        <span class="product-card__badge">-@(item.Discount!.Percentage.ToString("0"))%</span>
                    }
                </div>
            </a>

            <div class="card-body product-card__body d-flex flex-column">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                    <h3 class="product-card__title mb-0">
                        <a asp-controller="Product" asp-action="Details" asp-route-productId="@item.Id" class="product-link">
                            @(name.Length > 24 ? $"{name.Substring(0, 24)}..." : name)
                        </a>
                    </h3>

                    <a class="product-card__wish" asp-controller="WishList" asp-action="AddToWishList" asp-route-productId="@item.Id" aria-label="Add to wishlist">
                        <i class="bi bi-star"></i>
                    </a>
                </div>

                <p class="product-card__description mb-3">
                    @(description.Length > 70 ? $"{description.Substring(0, 70)}..." : description)
                </p>

                <div class="product-card__footer mt-auto">
                    <div class="product-card__price-row">
                        @if (hasDiscount)
                        {
                            <span class="last-price"><span>$@item.Price.ToString("0.00")</span></span>
                        }

                        <span class="new-price">
                            <span>$@discountedPrice.ToString("0.00")</span>
                        </span>
                    </div>

                    @if (hasDiscount)
                    {
                        <span class="product-card__discount-note">@(item.Discount!.Percentage.ToString("0"))% off</span>
                    }

                    <a class="card-button product-card__button" asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id">
                        Add to cart
                    </a>
                </div>
            </div>
        </div>
    </div>
}

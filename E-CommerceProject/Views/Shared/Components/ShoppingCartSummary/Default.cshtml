@model TotalCountViewModel

@if (Model.TotalCount > 0)
{
    <a class="btn text-light me-2" asp-controller="Cart" asp-action="Index" style="background-color:indigo"><i class="fa fa-shopping-cart"></i> Cart @Model.TotalCount</a>
}
else
{
    <a class="btn text-light me-2" asp-controller="Cart" asp-action="Index" style="background-color:indigo"><i class="fa fa-shopping-cart"></i> Cart </a>
}
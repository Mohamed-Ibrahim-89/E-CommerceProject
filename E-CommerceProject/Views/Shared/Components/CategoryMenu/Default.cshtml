@model IEnumerable<Category>

<div class="dropdown shop-category-dropdown">
    <button class="btn shop-category-toggle dropdown-toggle" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-funnel-fill"></i>
        <span>Categories</span>
    </button>

    <ul class="dropdown-menu shop-category-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton2">
        @foreach (var category in Model)
        {
            <li>
                <a class="dropdown-item" asp-controller="Home" asp-action="Index"
                   asp-route-categoryName="@category.Name">
                    @category.Name
                </a>
            </li>
        }
        <li>
            <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                All Products
            </a>
        </li>
    </ul>
</div>

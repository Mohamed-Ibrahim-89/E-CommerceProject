@model IEnumerable<Product>
@{
    ViewData["Title"] = "Discover Products";
    Layout = "_CustomLayout";
}

<!-- DataTables Core JS/CSS -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* 1. Force DataTables wrapper and tbody to act as a Bootstrap Flex Row */
    #ProductGridTbl, 
    #ProductGridTbl tbody {
        display: flex !important;
        flex-wrap: wrap !important;
        width: 100% !important;
        border: none !important;
        background: transparent !important;
    }

    #ProductGridTbl thead {
        display: none !important;
    }

    /* 2. Style each DataTable row as a grid column wrapper */
    #ProductGridTbl tbody tr {
        display: flex !important;
        border: none !important;
        padding: 0 !important;
        background: transparent !important;
    }

    #ProductGridTbl tbody td {
        display: block !important;
        width: 100% !important;
        border: none !important;
        padding: 0 !important;
        background: transparent !important;
    }

    /* 3. Customer Hero Banner */
    .hero-banner {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        border-radius: 1rem;
        color: white;
    }

    /* 4. Product Card Styling & Micro-Interactions */
    .store-card {
        border: 1px solid #edf2f7;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: #ffffff;
    }
    .store-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .store-card__img-wrapper {
        position: relative;
        width: 100%;
        padding-top: 75%; /* 4:3 Aspect Ratio */
        overflow: hidden;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        background-color: #f8f9fa;
    }
    .store-card__img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .store-card:hover .store-card__img {
        transform: scale(1.04);
    }

    .store-card__wishlist {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
        background-color: cadetblue;
        backdrop-filter: blur(4px);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: burlywood;
        transition: color 0.2s ease, background-color 0.2s ease;
    }
    .store-card__wishlist:hover {
        color: #dc3545;
        background: #ffffff;
        background-color: cadetblue;
    }

    .store-card__badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
        font-size: 0.7rem;
    }

    .store-card__desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.85rem;
        color: #6c757d;
        height: 2.6em;
    }

    /* 5. Search Bar Polish */
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 50rem;
        padding: 0.5rem 1.25rem;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }
    /* Micro Badges */
    .badge-soft-success {
        background-color: #d1e7dd;
        color: #0f5132;
    }
    .badge-soft-danger {
        background-color: #f8d7da;
        color: #842029;
    }
    .badge-soft-warning {
        background-color: #fff3cd;
        color: #664d03;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}

<div class="container-fluid px-4 py-4">
    
    <!-- Hero Banner -->
    <section class="shop-hero">
        <div class="shop-hero__content">
            <span class="shop-hero__eyebrow">New arrivals every day</span>
            <h1 class="shop-hero__title">Discover products that feel premium from the first glance.</h1>
            <p class="shop-hero__text">
                Browse featured products, filter by category, and find the right item faster with a cleaner,
                more focused shopping experience.
            </p>
        </div>
    </section>

    <div class="hop-toolbar d-flex flex-column flex-md-row gap-2 align-items-center justify-content-between mb-4">
        <div>
            <h2 class="h4 fw-bold text-dark mb-0">Featured Products</h2>
            <p class="text-muted small mb-0">Find what you're looking for below</p>
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <select id="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">Filter by category</option>
            </select>
        </div>
    </div>

    <!-- 4-Column Card Grid Container -->
    <div class="border-0 bg-transparent">
        <div class="card-body p-0">
            <table id="ProductGridTbl" class="w-100">
                <thead>
                    <tr><th>Products</th></tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        const urls = {
            list:        '@Url.Action("GetList", "Home")',
            details:     '@Url.Action("Details", "Product")',
            addToCart:   '@Url.Action("AddToCart", "Cart")',
            addWishlist: '@Url.Action("AddToWishList", "WishList")'
        };

        const fallbackImg = "https://cdn4.iconfinder.com/data/icons/picture-sharing-sites/32/No_Image-1024.png";
        let selectedCategoryId = null;

        function esc(value) {
            return $('<div>').text(value ?? '').html();
        }

        $(function () {
            const table = $('#ProductGridTbl').DataTable({
                processing: true,
                serverSide: true,
                destroy:    true,
                responsive: false,
                pageLength: 12, // Show 12 items per page (fits 4 columns evenly)
                lengthMenu: [[12, 24, 48], [12, 24, 48]],
                order:      [[0, 'desc']],
                language: {
                    emptyTable:  '<div class="w-100 text-center py-5 text-muted"><span class="bi bi-box-seam fs-1 d-block mb-2"></span>No products found.</div>',
                    zeroRecords: '<div class="w-100 text-center py-5 text-muted"><span class="bi bi-search fs-1 d-block mb-2"></span>No matching products found.</div>',
                    processing:  '<div class="w-100 text-center py-4"><span class="spinner-border text-primary" role="status"></span></div>',
                    search:      "_INPUT_",
                    searchPlaceholder: "Search for products..."
                },
                ajax: {
                    url:   urls.list,
                    type:  'GET',
                    "data": function(d) {
                        d.categoryId = $('#categoryId').val();
                    },
                    error: function () {
                        toastr.error('Unable to load products. Please try refreshing.');
                    }
                },
                columns: [
                    {
                        data: null,
                        orderable: true,
                        searchable: true,
                        render: function (data, type, row) {
                            const id = esc(String(row.ProductId));
                            const name = esc(row.Name ?? 'Product');
                            const description = esc(row.Description ?? 'No description available.');
                            const cover = row.Cover && row.Cover.trim() !== '' ? esc(row.Cover) : fallbackImg;
                            
                            const price = parseFloat(row.Price ?? 0);
                            const quantityInStock = parseInt(row.QuantityInStock ?? 0);
                            const inStock = quantityInStock > 0;
                            const discountPct = row.Discount ?? 0;
                            const hasDiscount = discountPct > 0;
                            const discountedPrice = hasDiscount ? (price - (price * (discountPct / 100))) : price;

                            const catName = row.Category ? esc((row.Category.Name ?? row.Category).toString()) : null;

                            return `
                                <div class="card store-card h-100 shadow-sm border-0 d-flex flex-column">
                                    
                                    <!-- Image & Overlay Buttons -->
                                    <div class="store-card__img-wrapper">
                                        <a href="${urls.details}?productId=${id}">
                                            <img src="${cover}" class="store-card__img" alt="${name}" onerror="this.src='${fallbackImg}'" />
                                        </a>
                                        
                                        ${hasDiscount ? `<span class="badge bg-danger rounded-pill store-card__badge">-${discountPct}% OFF</span>` : ''}

                                        <a href="${urls.addWishlist}?productId=${id}" class="store-card__wishlist shadow-sm" title="Add to Wishlist">
                                            <span class="bi bi-heart-fill" aria-hidden="true"></span>
                                        </a>
                                    </div>

                                    <!-- Details -->
                                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                        ${catName ? `<span class="badge bg-light text-primary border border-primary-subtle align-self-start mb-2">${catName}</span>` : ''}

                                        <h3 class="h6 fw-bold mb-1">
                                            <a href="${urls.details}?productId=${id}" class="text-dark text-decoration-none text-truncate d-block" style="color: #fd7e14 !important">
                                                ${name}
                                            </a>
                                        </h3>

                                        <p class="store-card__desc mb-3">
                                            ${description}
                                        </p>

                                        <!-- Footer / Price & Add Button -->
                                        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                            <div>
                                                ${hasDiscount ? `
                                                    <small class="text-decoration-line-through d-block">$${price.toFixed(2)}</small>
                                                    <span class="fs-6 fw-bold text-success">$${discountedPrice.toFixed(2)}</span>
                                                ` : `
                                                    <span class="fs-6 fw-bold text-dark">$${price.toFixed(2)}</span>
                                                `}
                                            </div>
                                            <div>
                                            ${inStock ? `
                                                ${quantityInStock < 10 ? `
                                                    <small class="badge badge-soft-warning rounded-pill px-3 py-1-5 fw-bold">Low stock</small>
                                                ` : `
                                                    <small class="badge badge-soft-success rounded-pill px-3 py-1-5 fw-bold">In stock</small>
                                                `}
                                                ` : `
                                                <small class="badge badge-soft-danger rounded-pill px-3 py-1-5 fw-bold">Out of stock</small>
                                            `}
                                            </div>
                                            <a href="${urls.addToCart}?productId=${id}" class="btn btn-primary rounded-pill px-3 py-1-5 btn-sm fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                                                <span class="bi bi-cart-plus" aria-hidden="true"></span> Add
                                            </a>
                                        </div>
                                    </div>

                                </div>`;
                        }
                    }
                ],

                // Apply Bootstrap 4-column responsive layout to DataTables TR elements
                createdRow: function (row) {
                    // col-xl-3 & col-lg-3 = 4 columns on large screens
                    // col-md-6 = 2 columns on tablets
                    // col-12 = 1 column on mobile screens
                    $(row).addClass('col-12 col-md-6 col-lg-3 col-xl-3 p-2 mb-3');
                },

                dom: '<"d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4"<"search-input-wrapper"f>>rt<"d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mt-4"lip>'
            });
        });

        $('#categoryId').on('change', function() {
            $('#ProductGridTbl').DataTable().ajax.reload();
        });

    </script>
}
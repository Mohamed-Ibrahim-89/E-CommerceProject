@model IEnumerable<Product>
@{
    ViewData["Title"] = "Home Page";
    Layout = "_CustomLayout";
}

@if (!Model.Any())
{
    <div class="text-center text-warning">
        <h1>No products at this point</h1>
    </div>
}
else
{
    <section class="shop-hero">
        <div class="shop-hero__content">
            <span class="shop-hero__eyebrow">New arrivals every day</span>
            <h1 class="shop-hero__title">Discover products that feel premium from the first glance.</h1>
            <p class="shop-hero__text">
                Browse featured products, filter by category, and find the right item faster with a cleaner,
                more focused shopping experience.
            </p>
        </div>
    </section>

    <div>
        <div class="row text-center mb-4">
            <div class="col-12">
                <h2 class="shop-section-title">Featured Products</h2>
                <p class="shop-section-subtitle" style="color:#c2d36d">Check out our most popular and recommended products</p>
            </div>
        </div>

        <div class="shop-toolbar d-flex flex-column flex-md-row gap-2 align-items-center mb-4">
            <div class="search-wrapper position-relative flex-grow-1 w-100">
                <span class="search-icon position-absolute top-50 start-0 translate-middle-y ms-3 text-muted">
                </span>
                <input class="form-control shop-search ps-5 py-2-5" type="search" id="liveSearchTag"
                       value="@ViewBag.SearchQuery" placeholder="Search for products..." aria-label="Search">
            </div>
            <div>
                @await Component.InvokeAsync("CategoryMenu")
            </div>
        </div>

        <div class="row shop-grid" id="productCards">
            <partial name="_ProductCard" model="Model" />
        </div>
    </div>
}

@section scripts {
    <script>
        $('#liveSearchTag').on('keyup', function () {
            LiveSearch()
        });

        function LiveSearch(){
            var searchValue = $('#liveSearchTag').val();

            $.ajax({
                url: '@Url.Action("Search", "Product")',
                type: "GET",
                data: { searchQuery: searchValue },
                datatype:"html",
                success: function (data) {
                    $('#productCards').html(data);
                }
            });
        }
    </script>
}

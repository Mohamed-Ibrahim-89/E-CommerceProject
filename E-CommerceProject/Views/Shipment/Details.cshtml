@model ShipmentDetailsViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "_CustomLayout";
}

<style>
    .card {
        background-color: #343a40;
        color: #fff;
    }

    .card-header {
        background-color: #5cb85c;
        color: #fff;
    }

    .card-body {
        padding: 1.25rem 2rem;
    }

    .table {
    color: #000; 
    }

    .table th,
    .table td {
        border-top-color: #000; 
        color: #000; 
    }
</style>

<div class="container mt-2 d-flex justify-content-between align-items-center">
    <h3 class="mt-3 mb-3">Details of Shipment</h3>
    @if (User.Identity!.IsAuthenticated && User.IsInRole(Constants.Roles.Admin))
    {
        <a asp-action="List" class="btn btn-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>back
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>back
        </a>
    }
    </div>
</div>
<hr />

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card" style="width:590px!important">
                        <div class="card-header">
                            Shipment Information
                        </div>
                        <div class="card-body">
                            <dl class="row" style="color:black">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.Carrier)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Carrier)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.TrackingNumber)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.TrackingNumber)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.ShippingDate)
                                </dt>
                                <dd class="col-sm-8">
                                    @Model.ShippingDate.ToShortDateString()
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.EstimatedDeliveryDate)
                                </dt>
                                <dd class="col-sm-8">
                                    @Model.EstimatedDeliveryDate.ToShortDateString()
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.ShippingCost)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.ShippingCost)
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card" style="width:400px!important; height:275px">
                        <div class="card-header">
                            Order Information
                        </div>
                        <div class="card-body">
                            <dl class="row" style="color:black">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.Status)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Status)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.OrderDate)
                                </dt>
                                <dd class="col-sm-8">
                                    @Model.OrderDate.ToShortDateString()
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.TotalPrice)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.TotalPrice)
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card" style="width:590px!important">
                        <div class="card-header">
                            Customer Information
                        </div>
                        <div class="card-body">
                            <dl class="row" style="color:black">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CustomerName)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CustomerName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.PhoneNumber)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.PhoneNumber)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.AddressLine1)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.AddressLine1)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.AddressLine2)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.AddressLine2)
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card" style="width: 400px !important">
                        <div class="card-header">
                            Order Details
                        </div>
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderDetails!)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Price</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

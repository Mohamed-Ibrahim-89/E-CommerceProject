@model IEnumerable<ShipmentViewModel>

@{
    ViewData["Title"] = "Orders";
    Layout = "_CustomLayout";
}

<div class="container mt-4 d-flex justify-content-between align-items-center">
    <h1 class="mt-3 mb-3">Your Orders</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Go back to Shopping
    </a>
</div>
<hr />

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        No orders for you yet!.
    </div>
}
else
{

    <table class="table table-info">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Carrier)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TrackingNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ShippingDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EstimatedDeliveryDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ShippingCost)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="data">
                    <td>
                        @Html.DisplayFor(modelItem => item.Carrier)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TrackingNumber)
                    </td>
                    <td>
                        @item.ShippingDate.ToShortDateString()
                    </td>
                    <td>
                        @item.EstimatedDeliveryDate.ToShortDateString()
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ShippingCost)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StatusName)
                    </td>
                    <td>
                        <div class="btn-group">
                            <a asp-controller="Shipment" asp-action="Details" asp-route-shipmentId="@item.Id" class="btn btn-info">
                                <i class="bi bi-info-circle"></i>
                                Details
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

